# Copy to .env.local and fill in. Never commit .env.local.

# Neon: Dashboard > your project > Connect > copy the connection string (pooled is fine).
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Admins created by `npm run db:setup` (comma-separated). Use real inboxes: reset links go here.
ADMIN_EMAILS="first-admin@example.com,second-admin@example.com"

# Resend: https://resend.com/api-keys. The from address must be on a domain you verified in Resend.
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="Tech Digital Marketer <no-reply@yourdomain.com>"

# The public site URL (reset links, sitemap, robots.txt, canonical URLs) is set in
# src/lib/site.ts as https://www.techdigitalmarketer.com, not read from an env var.


